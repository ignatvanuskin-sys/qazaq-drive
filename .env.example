# ---------------------------------------------------------------------------
# QAZAQ DRIVE SCHOOL — environment
# Copy to .env (locally) or set these in your hosting provider's dashboard.
# Never commit real values. Nothing here is exposed to the browser except
# NEXT_PUBLIC_* variables.
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# SQLite (default, zero-config local run)
DATABASE_URL="file:./dev.db"
# PostgreSQL (production) — also change provider in prisma/schema.prisma
# DATABASE_URL="postgresql://user:password@host:5432/qazaqdrive?schema=public"

# Core ----------------------------------------------------------------------
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-32-plus-character-random-string"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Salt for hashed IP / user-agent storage (no raw PII in analytics)
HASH_SALT="change-me-random-salt"

# First admin (used only by `npm run db:seed`) ------------------------------
ADMIN_EMAIL="admin@qazaqdrive.kz"
ADMIN_PASSWORD="set-a-unique-password-min-12-chars"

# Telegram Bot --------------------------------------------------------------
# 1. Create a bot with @BotFather, copy the token
# 2. Add the bot to the admin group, send a message, read chat id:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_WEBHOOK_SECRET=""

# WhatsApp ------------------------------------------------------------------
# Public link only (no API key). Automatic messages require WhatsApp Business
# Platform and the user's opt-in — this project intentionally does not fake it.
NEXT_PUBLIC_WHATSAPP="77080861028"

# Email (optional) ----------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="QAZAQ DRIVE SCHOOL <no-reply@qazaqdrive.kz>"
ADMIN_EMAIL_RECIPIENT="qazaqdriveschool@mail.ru"

# CRM webhook (optional, provider-agnostic) --------------------------------
CRM_WEBHOOK_URL=""
CRM_WEBHOOK_SECRET=""

# AI consultant (OpenAI-compatible API) ------------------------------------
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_TEMPERATURE="0.3"
AI_MAX_TOKENS="500"
AI_TIMEOUT_MS="22000"
# Hard daily ceiling on assistant answers (cost protection)
AI_DAILY_MESSAGE_LIMIT="400"

# Analytics (optional) -----------------------------------------------------
NEXT_PUBLIC_GA_ID=""
